{
  "name": "book-rating-aggregator",
  "version": "1.0.0",
  "description": "Multi-platform Book Rating and Review Aggregator (Douban, Goodreads, Google Books, Amazon)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "test": "node tests/e2e/run-all-tests.js",
    "share": "node scripts/tunnel-daemon.js",
    "install:all": "npm install && npm --prefix client install"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
